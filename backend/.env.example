# Copy to backend/.env and adjust as needed. All vars are optional; these are
# the defaults the app already uses for local development.

# PostgreSQL connection (matches docker-compose.yml).
PFAI_DATABASE_URL=postgresql+psycopg2://finance:finance@127.0.0.1:5432/finance

# JWT signing key. Change this to a random value for anything non-local.
PFAI_SECRET_KEY=dev-insecure-change-me

# Demo account seeded by `python -m app.seed`.
PFAI_DEMO_EMAIL=demo@financeai.app
PFAI_DEMO_PASSWORD=demo1234

# --- Phase 2: optional LLM-assisted PDF extraction (AWS Bedrock) ---
# PDF parsing works without these; set them only to enable the AI fallback.
# PFAI_LLM_ENABLED=true
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# PFAI_AWS_REGION=us-east-1
# PFAI_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
