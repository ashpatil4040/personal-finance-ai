{
  "name": "AI-Assisted Personal Finance",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && source .venv/bin/activate && PFAI_LLM_ENABLED=true uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    { "name": "backend api", "port": 8000 },
    { "name": "frontend", "port": 5173 },
    { "name": "postgres", "port": 5432 }
  ]
}
